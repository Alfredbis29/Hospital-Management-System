<nav class="navbar">
  <div class="navbar-brand">
    <%= link_to 'Hospital Management System', root_path, class: 'navbar-logo' %>
  </div>
  
  <div class="navbar-menu">
    <% if user_signed_in? %>
      <span class="navbar-user">Welcome, <%= current_user.email %></span>
      <%= link_to 'Home', root_path, class: 'navbar-link' %>
      <%= link_to 'Edit Profile', edit_user_registration_path, class: 'navbar-link' %>
      <%= button_to 'Sign Out', destroy_user_session_path, method: :delete, class: 'navbar-btn navbar-btn-danger' %>
    <% else %>
      <%= link_to 'Sign In', new_user_session_path, class: 'navbar-link' %>
      <%= link_to 'Sign Up', new_user_registration_path, class: 'navbar-btn navbar-btn-primary' %>
    <% end %>
  </div>
</nav>

