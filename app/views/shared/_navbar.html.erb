<nav class="bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
        <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30">
          <span class="text-white text-xl">🏥</span>
        </div>
        <span class="text-xl font-bold text-slate-800 group-hover:text-blue-600 transition-colors">HMS</span>
      <% end %>
      
      <!-- Navigation -->
      <div class="flex items-center space-x-2">
        <% if user_signed_in? %>
          <div class="hidden sm:flex items-center mr-4 px-3 py-1.5 bg-slate-100 rounded-full">
            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
            <span class="text-sm text-slate-600"><%= current_user.email.split('@').first %></span>
          </div>
          
          <%= link_to 'Dashboard', root_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-all" %>
          <%= link_to 'Profile', edit_user_registration_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-all" %>
          <%= button_to 'Logout', destroy_user_session_path, method: :delete, class: "px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 rounded-lg shadow-sm hover:shadow-md transition-all cursor-pointer" %>
        <% else %>
          <%= link_to 'Sign In', new_user_session_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-all" %>
          <%= link_to 'Get Started', new_user_registration_path, class: "px-5 py-2.5 text-sm font-medium text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 rounded-lg shadow-md hover:shadow-lg shadow-blue-500/30 transition-all" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
