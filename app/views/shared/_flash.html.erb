<% flash.each do |type, message| %>
  <% bg_class = type == 'notice' || type == 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700' %>
  <div class="<%= bg_class %> border px-4 py-3 rounded-lg mb-6 animate-fade-in" role="alert">
    <span class="block sm:inline font-medium"><%= message %></span>
  </div>
<% end %>
