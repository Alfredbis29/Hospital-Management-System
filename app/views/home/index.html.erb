<div class="max-w-2xl mx-auto mt-10">
  <div class="bg-white rounded-2xl shadow-xl p-8 sm:p-12 text-center">
    <div class="text-6xl mb-6">🏥</div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
      Hospital Management System
    </h1>
    
    <% if user_signed_in? %>
      <p class="text-lg text-gray-600 mb-2">
        Hello, <span class="font-semibold text-blue-600"><%= current_user.email %></span>!
      </p>
      <p class="text-gray-500 mb-8">
        You are successfully logged in. Manage patients, doctors, appointments, and more.
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <%= link_to 'Edit Profile', edit_user_registration_path, class: "inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition shadow-md hover:shadow-lg" %>
        <%= button_to 'Sign Out', destroy_user_session_path, method: :delete, class: "inline-flex items-center justify-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition shadow-md hover:shadow-lg" %>
      </div>
    <% end %>
  </div>
</div>
